generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}



model Notifications {
  id Int      @id @default(autoincrement())
  title          String   @db.VarChar(100)
  description    String?  @db.VarChar(255)
  idUser         Int
  read           Boolean
  createdIn       DateTime
  updatedIn      DateTime

  user           Users    @relation(fields: [idUser], references: [id])
}

model Users {
  id      Int        @id @default(autoincrement())
  name         String     @db.VarChar(255)
  email        String    @unique @db.VarChar(255)
  password     String     @db.Text
  photo        String?    @db.Text
  role         Int
  createdIn     DateTime
  path          String?
  updatedIn    DateTime
  status       Boolean

  notifications Notifications[]
  Contributors Contributors[]
}

model VerificationsCodes {
  id Int     @id @default(autoincrement())
  code               String  @db.VarChar(45)
  email              String  @db.VarChar(255)
  used               Boolean
  createdIn          DateTime
}


model Contributors {
  id             Int       @id @default(autoincrement())
  fullName       String    @db.VarChar(100)
  gender         String    @db.VarChar(45)
  biNumber       String    @db.VarChar(20)
  dateOfBirth    DateTime
  phoneNumber    String    @db.VarChar(255)
  province       String    @db.VarChar(45)
  municipality   String    @db.VarChar(45)
  neighborhood   String    @db.VarChar(45)
  email          String    @db.VarChar(100)
  digitalCardLink String?   @db.Text
  createdIn      DateTime
  updatedIn      DateTime
  idUser         Int
  status         Boolean   
 
  user           Users     @relation(fields: [idUser], references: [id])
  documents      Documents[]
}

model Documents {
  id            Int       @id @default(autoincrement())
  description   String    @db.VarChar(105)
  fileUrl       String    @db.Text
  typeDocument  Int
  name          String    @db.VarChar(105)
  createdIn     DateTime
  updatedIn     DateTime
  idContributor Int
  status        Boolean   

  contributor   Contributors @relation(fields: [idContributor], references: [id])
}